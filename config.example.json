{
  "proxy": {
    "coarse_height": 360,
    "review_height": 720,
    "scene_threshold": 0.32,
    "max_shot_seconds": 20
  },
  "speech": {
    "sample_rate": 16000,
    "engine": "whisper.cpp",
    "word_timestamps": true
  },
  "vision": {
